# Copy to .env and use `set -a; source .env` (bash) before batch_reload.sh,
# or export these variables in the shell / systemd unit.

# Required: SSH enable password for the AP CLI session (same secret used for ena).
AP_RELOAD_PASSWORD=

# FQDN is built as ${HOST_FROM_LIST}.${AP_DNS_DOMAIN} for fping and SSH target.
# Override with your management DNS zone (example below is documentation-only).
AP_DNS_DOMAIN=example.invalid

# SSH login on the AP (vendor default accounts vary; set explicitly in production).
AP_SSH_USER=admin

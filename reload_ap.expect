#!/usr/bin/expect -f
# Reads AP_RELOAD_PASSWORD and optional AP_SSH_USER from the environment.
set SYSTEM [lindex $argv 0]
if {$SYSTEM eq ""} {
    puts stderr "usage: reload_ap.expect <hostname-or-shortname>"
    exit 2
}
if {![info exists ::env(AP_RELOAD_PASSWORD)] || $::env(AP_RELOAD_PASSWORD) eq ""} {
    puts stderr "AP_RELOAD_PASSWORD is not set"
    exit 1
}
set PASSWORD $::env(AP_RELOAD_PASSWORD)
if {[info exists ::env(AP_SSH_USER)] && $::env(AP_SSH_USER) ne ""} {
    set ssh_user $::env(AP_SSH_USER)
} else {
    set ssh_user "admin"
}

spawn ssh ${ssh_user}@${SYSTEM}

set timeout 15
expect {
    timeout {
        puts "Connection timed out"
        exit 1
    }

    "yes/no" {
        send "yes\r"
        exp_continue
    }

    "assword:" {
        send -- "$PASSWORD\r"
    }
}

expect ">" { send "ena\r" }
expect "assword:" { send -- "$PASSWORD\r" }
expect "#" { send "reload\r" }
expect "confirm" { send "\r" }
expect "failed" { send "\r" }

exit 0
